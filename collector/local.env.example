DCS_ENV_ID=staging
DCS_ENV_LABEL=Staging
DCS_PROJECT_ID=your-project-id
DCS_REGION=us-central1
DCS_SPANNER_INSTANCE_ID=your-instance
DCS_SPANNER_DATABASE_ID=your-database
DCS_DATACOMMONS_SERVICE_NAME=your-datacommons-service
DCS_INGESTION_WORKFLOW_NAME=your-ingestion-workflow
DCS_ARTIFACTS_BUCKET_NAME=your-artifacts-bucket
DCS_PUBLIC_ENDPOINT_URL=https://api.example.org
DCS_FRONTEND_URL=https://www.example.org
DCS_DATA_SOURCE_PREFIXES=agency-a,agency-b
DCS_INPUT_PREFIX=ingestion/input/

# Everything below is optional; the values shown are the defaults.
# The entity dc_api resolves, and the name it must come back with.
# DCS_CANARY_NODE=country/GTM
# DCS_CANARY_NAME=Guatemala
# Window for the golden signals read from Cloud Monitoring, one point a minute.
# DCS_SIGNALS_WINDOW_MINUTES=60
# Targets are emitted in the document, so the page draws what was judged.
# DCS_TARGET_AVAILABILITY_PCT=99.5
# DCS_TARGET_LATENCY_P95_MS=1000
# DCS_TARGET_RUN_CPU_PCT=80
# DCS_TARGET_RUN_MEMORY_PCT=80
# Google's recommendation for a regional instance; use 45 for multi-region.
# DCS_TARGET_SPANNER_CPU_PCT=65
# Below this, errors and latency are shown but not judged.
# DCS_TARGET_MIN_REQUESTS_PER_HOUR=100
# Empty: the age of the last successful ingestion is shown but not judged.
# DCS_TARGET_INGESTION_MAX_AGE_HOURS=
# DCS_TARGET_MAX_ROW_DROP_PCT=10

# Development only: serve a saved document instead of collecting. Replay needs
# none of the settings above and no credentials. SHIFT_TIME moves every
# timestamp in it by (now - generated_at), so the demo reads as current.
# DCS_REPLAY_FILE=tests/fixtures/demo.json
# DCS_REPLAY_SHIFT_TIME=true

# A local run has no IAP in front of it and no assertion to verify, so the gate
# is switched off explicitly. Deployed revisions leave this unset: the default is
# closed, and the Terraform module supplies the IAP audience below.
DCS_REQUIRE_AUTH=false
# DCS_IAP_AUDIENCE=/projects/<PROJECT_NUMBER>/apps/<...>
