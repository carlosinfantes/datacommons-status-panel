DCS_ENV_ID=staging
DCS_ENV_LABEL=Staging
DCS_PROJECT_ID=your-project-id
DCS_REGION=us-central1
DCS_SPANNER_INSTANCE_ID=your-instance
DCS_SPANNER_DATABASE_ID=your-database
DCS_DATACOMMONS_SERVICE_NAME=your-datacommons-service
DCS_INGESTION_WORKFLOW_NAME=your-ingestion-workflow
DCS_ARTIFACTS_BUCKET_NAME=your-artifacts-bucket
DCS_PUBLIC_ENDPOINT_URL=https://api.example.org
DCS_FRONTEND_URL=https://www.example.org
DCS_DATA_SOURCE_PREFIXES=agency-a,agency-b
DCS_INPUT_PREFIX=ingestion/input/
DCS_PEERS=[]

# A local run has no IAP in front of it and no assertion to verify, so the gate
# is switched off explicitly. Deployed revisions leave this unset: the default is
# closed, and the Terraform module supplies the audiences below.
DCS_REQUIRE_AUTH=false
# DCS_IAP_AUDIENCE=/projects/<PROJECT_NUMBER>/apps/<...>
# DCS_SELF_AUDIENCE=https://<this-panel-url>
# DCS_ALLOWED_CALLERS=peer-panel-sa@other-project.iam.gserviceaccount.com
